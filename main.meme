# main.meme — `split` CLI: a thin argv router over split_logic.meme.
# Every error is one line + exit 1 (via `fail with`). Unknown command
# prints usage and exits 1. Data lives in data/*.json; missing or corrupt
# files are handled through Optional reads (never a traceback).

use split_logic

define argc: Int as argument count
if argc < 2:
    print "Error: unknown command. Usage: split <add-person|add-expense|pay|balances|settle|ledger> ..."
    exit with code 1
define cmd: String as argument 1

# ---------- load ledger state (missing/corrupt -> empty) ----------
define people: List<Person> as empty List<Person>
define loaded_people: Optional<List<Person>> as read json records Person from file "data/people.json" or else nothing
if loaded_people is not nothing:
    set people to value of loaded_people

define expenses: List<Expense> as empty List<Expense>
define loaded_expense_rows: Optional<List<ExpenseRow>> as read json records ExpenseRow from file "data/expenses.json" or else nothing
if loaded_expense_rows is not nothing:
    define loaded_rows: List<ExpenseRow> as value of loaded_expense_rows
    for each row in loaded_rows:
        define exp: Expense as from_row(row)
        add exp to expenses

define payments: List<Payment> as empty List<Payment>
define loaded_payments: Optional<List<Payment>> as read json records Payment from file "data/payments.json" or else nothing
if loaded_payments is not nothing:
    set payments to value of loaded_payments

match cmd:
    when "add-person":
        if argc != 3:
            fail with "Error: usage: split add-person <name>"
        define name: String as argument 2
        if person_known(people, name):
            fail with "Error: person already exists: " + name
        define p: Person as Person(name=name)
        add p to people
        create directory "data"
        write people as json to file "data/people.json"
        print "Added person " + name

    when "add-expense":
        if argc < 4:
            fail with "Error: usage: split add-expense <payer> <total-cents> <name1> <name2> ... [exact <c1> <c2> ... | shares <w1> <w2> ...]"
        define payer: String as argument 2
        define total: Int as parse_positive_cents(argument 3)
        if total < 0:
            fail with "Error: invalid total-cents (must be a positive integer): " + argument 3
        if not (person_known(people, payer)):
            fail with "Error: unknown person: " + payer
        # scan for the optional split-mode keyword (equal | exact | shares);
        # note: a participant cannot be named equal, exact, or shares
        define mode: String as "equal"
        define split_at: Int as argc
        define keyword_found: Bool as false
        define i: Int as 4
        while i <= argc - 1:
            define a: String as argument i
            if a == "equal" or a == "exact" or a == "shares":
                if keyword_found:
                    fail with "Error: duplicate split-mode keyword"
                set keyword_found to true
                set mode to a
                set split_at to i
            add 1 to i
        # participants come before the keyword
        define names: List<String> as empty List<String>
        define j: Int as 4
        while j <= split_at - 1:
            define nm: String as argument j
            add nm to names
            add 1 to j
        if length of names == 0:
            fail with "Error: at least one participant is required"
        if has_duplicate(names):
            fail with "Error: duplicate participant name"
        for each participant in names:
            if not (person_known(people, participant)):
                fail with "Error: unknown person: " + participant
        # mode-specific numeric arguments (parsed whenever an explicit
        # keyword was present, including `equal`, so trailing garbage is
        # rejected rather than silently ignored)
        define nums: List<Int> as empty List<Int>
        if split_at < argc:
            define k: Int as split_at + 1
            while k <= argc - 1:
                define v: Int as integer value of argument k or else -1
                if v < 0:
                    fail with "Error: invalid number: " + argument k
                add v to nums
                add 1 to k
        if mode == "equal":
            if length of nums > 0:
                fail with "Error: equal mode takes no extra arguments"
        if mode == "exact":
            if length of nums != length of names:
                fail with "Error: exact mode needs one amount per participant"
            for each c in nums:
                if c < 0:
                    fail with "Error: exact amounts must be non-negative"
            if not (exact_sums_ok(nums, total)):
                fail with "Error: exact amounts must sum to the total"
        if mode == "shares":
            if length of nums != length of names:
                fail with "Error: shares mode needs one weight per participant"
            if not (parts_positive(nums)):
                fail with "Error: share weights must be positive integers"
        define eid: Int as next_entry_id(expenses, payments)
        define exp: Expense as Expense(id=eid, payer=payer, total=total, mode=mode, participants=names, exact=nums, shares=nums)
        add exp to expenses
        create directory "data"
        define rows: List<ExpenseRow> as empty List<ExpenseRow>
        for each e in expenses:
            define row: ExpenseRow as to_row(e)
            add row to rows
        write rows as json to file "data/expenses.json"
        print "Added expense " + text of eid + ": " + payer + " paid " + money(total) + " for " + join names with ", " + " (" + mode + ")"

    when "pay":
        if argc != 5:
            fail with "Error: usage: split pay <from> <to> <cents>"
        define from_p: String as argument 2
        define to_p: String as argument 3
        define cents: Int as integer value of argument 4 or else -1
        if cents <= 0:
            fail with "Error: payment cents must be a positive integer: " + argument 4
        if not (person_known(people, from_p)):
            fail with "Error: unknown person: " + from_p
        if not (person_known(people, to_p)):
            fail with "Error: unknown person: " + to_p
        if from_p == to_p:
            fail with "Error: from and to must be different people"
        define pid: Int as next_entry_id(expenses, payments)
        define pay: Payment as Payment(id=pid, from_p=from_p, to_p=to_p, cents=cents)
        add pay to payments
        create directory "data"
        write payments as json to file "data/payments.json"
        print "Added payment " + text of pid + ": " + from_p + " paid " + to_p + " " + money(cents)

    when "balances":
        define net: Map<String, Int> as compute_balances(expenses, payments)
        define lines: List<String> as balance_lines(net)
        for each line in lines:
            print line

    when "settle":
        define net: Map<String, Int> as compute_balances(expenses, payments)
        define transfers: List<Transfer> as settle_transfers(net)
        if length of transfers == 0:
            print "All balances are settled."
        else:
            define lines: List<String> as settle_lines(net)
            for each line in lines:
                print line
            define n_t: Int as length of transfers
            print "Settled with " + text of n_t + " transfers."
            # replay proof: applying the transfers must zero every balance
            define replay: Map<String, Int> as apply_transfers(net, transfers)
            assert all_balances_zero(replay)
            print "Replay proof: all balances are zero."

    when "ledger":
        define lines: List<String> as ledger_lines(expenses, payments)
        if length of lines == 0:
            print "Ledger is empty."
        else:
            for each line in lines:
                print line

    otherwise:
        print "Error: unknown command '" + cmd + "'. Usage: split <add-person|add-expense|pay|balances|settle|ledger> ..."
        exit with code 1
